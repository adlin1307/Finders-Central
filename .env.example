# Flask Session Security
# Generate a strong random key (e.g. using `python3 -c "import secrets; print(secrets.token_hex(32))"`)
FLASK_SECRET_KEY=replace-with-a-secure-random-secret-key

# Email Server Configuration (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=finders.central@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password
MAIL_DEFAULT_SENDER=finders.central@gmail.com

# Optional test email recipient for /test-email
TEST_EMAIL_RECIPIENT=your-test-email@example.com
